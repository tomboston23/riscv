OUTPUT_ARCH(riscv)
ENTRY(_start)

MEMORY
{
    ROM (rx) : ORIGIN = RAM_ORIGIN, LENGTH = 64K
    RAM (rw) : ORIGIN = RAM_ORIGIN + 64K, LENGTH = 256K
}

_stack_top = ORIGIN(RAM) + LENGTH(RAM);

SECTIONS
{
    . = ORIGIN(RAM);
    <% if f_riscv_exit_inst_present.to_i == 0 %>
    .tohost : ALIGN(8)
    {
        tohost = .;
        QUAD(0);

        fromhost = .;
        QUAD(0);
    } > RAM
    <% end %>
    .text : ALIGN(4)
    {
        *(.text.init)
        *(.text)
        *(.text*)
    } > ROM

    .rodata : ALIGN(4)
    {
        *(.rodata*)
    } > ROM

    .data : ALIGN(4)
    {
        *(.data*)
    } > RAM

    .print_dump : ALIGN(4)
    {
        *(.print_dump*)
    } > RAM

    .bss : ALIGN(4)
    {
        *(.bss*)
        *(COMMON)
    } > RAM

    _end = .;
}